# Los archivos que se ejecutan en Linux deben conservarse con saltos de linea LF.
# Sin esto, un Git de Windows con core.autocrlf=true los cheoutea con CRLF y
# setup_server.sh / update.sh / monitorolt.service fallan en el servidor.
* text=auto

*.sh            text eol=lf
*.service       text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Utilitario de Windows: conserva CRLF
*.bat           text eol=crlf

# Binarios: nunca los toque Git
*.exe           binary
*.png           binary
*.jpg           binary
*.log           binary
