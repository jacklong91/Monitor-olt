# Copiame como .env en el servidor y completa los valores.
# chmod 600 .env
# Este archivo NO debe contener credenciales reales: .env si, .env.example no.

# Panel AdminOLT. Puede ser la raiz o la lista; el bot deriva la otra.
URL_ADMIN=https://TU-PANEL.ejemplo.com/olt/list/
USER_ADMIN=usuario_del_panel
PASS_ADMIN=clave_del_panel

# Telegram: token de @BotFather y chat_id del canal (acepta varios separados por coma)
TG_TOKEN=1234567890:AAAA...
TG_CHAT_ID=-1001234567890

# 1 = avisar al canal si el bot muere de forma inesperada
# 0 = silencio total (los paros planificados nunca avisan)
AVISO_CIERRE_INESPERADO=1

# Donde Playwright guarda Chromium. En Linux usar una ruta del proyecto.
PLAYWRIGHT_BROWSERS_PATH=/opt/monitorolt/.pw-browsers

# OPCIONAL: si el repo es publico, puedes sacar de codigo los nombres reales
# y ponerlos aqui (separados por coma). Si quedan vacios, el bot usa los del codigo.
OLTS_CRITICAS=
OLTS_INACTIVAS_PERMANENTES=
NOMBRES_EQUIPO=
